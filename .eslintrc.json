{
	"root": true,
	"extends": [
		"wikimedia/client",
		"wikimedia/jquery",
		"wikimedia/mediawiki"
	],
	"rules": {
		"camelcase": [
			"error",
			{
				"properties": "never"
			}
		],
		"jsdoc/check-tag-names": [
			"warn",
			{
				"definedTags": [
					"experimental"
				]
			}
		]
	},
	"ignorePatterns": [
		"docs/"
	],
	"env": {
		"commonjs": true
	}
}
